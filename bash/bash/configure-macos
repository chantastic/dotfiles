#!/bin/bash
set -euo pipefail

# Appearance
osascript -e 'tell application "System Events" to tell appearance preferences to set dark mode to true'

# Keyboard
defaults write NSGlobalDomain AppleKeyboardUIMode -int 3

# Keep Apple's press-and-hold special character suggester enabled.
# Tradeoff: macOS uses InitialKeyRepeat both for the special-character popover
# and for the first repeated character on keys with no alternates. KeyRepeat
# only controls repeats after that first one.
defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool true

# Keep the special-character popover reasonably quick.
# Tradeoff: keys with no alternates can still emit one duplicate after this delay.
# macOS stores these values in 15ms units.
defaults write NSGlobalDomain InitialKeyRepeat -int 35
defaults write NSGlobalDomain KeyRepeat -int 300000

# Menu bar
defaults write NSGlobalDomain _HIHideMenuBar -bool false
defaults write com.apple.menuextra.clock Show24Hour -bool true
defaults write com.apple.menuextra.clock ShowDayOfWeek -bool false
defaults write com.apple.menuextra.clock ShowDate -int 0

# Menu bar: Control Center-backed items
defaults write com.apple.controlcenter "NSStatusItem Visible WiFi" -bool false
defaults write com.apple.controlcenter "NSStatusItem Visible Bluetooth" -bool false
defaults write com.apple.controlcenter "NSStatusItem Visible Sound" -bool false
defaults write com.apple.controlcenter "NSStatusItem Visible Battery" -bool false
defaults write com.apple.controlcenter "NSStatusItem Visible NowPlaying" -bool false
defaults write com.apple.controlcenter "NSStatusItem Visible FocusModes" -bool false
defaults write com.apple.controlcenter "NSStatusItem Visible ScreenMirroring" -bool false

# Dock: visibility and contents
defaults write com.apple.dock autohide -bool true
defaults write com.apple.dock persistent-apps -array
defaults write com.apple.dock persistent-others -array

# Dock: behavior
defaults write com.apple.dock show-recents -bool false
defaults write com.apple.dock minimize-to-application -bool true

# Dock: animation
defaults write com.apple.dock autohide-delay -float 0
defaults write com.apple.dock autohide-time-modifier -float 0.2

# Finder
defaults write com.apple.finder NewWindowTarget -string "PfLo"
defaults write com.apple.finder NewWindowTargetPath -string "file://${HOME}/Downloads/"

# Safari
# Current macOS stores Safari prefs in a TCC-protected container. Grant your
# terminal Full Disk Access before running this script.
# Safari must be quit first or it may write its cached prefs back over these.
safari_plist="${HOME}/Library/Containers/com.apple.Safari/Data/Library/Preferences/com.apple.Safari.plist"

killall Safari 2>/dev/null || true

if plutil -lint "${safari_plist}" >/dev/null 2>&1; then
  # Safari: AutoFill web forms
  defaults write "${safari_plist}" AutoFillFromAddressBook -bool false
  defaults write "${safari_plist}" AutoFillPasswords -bool false
  defaults write "${safari_plist}" AutoFillCreditCardData -bool false
  defaults write "${safari_plist}" AutoFillMiscellaneousForms -bool false

  # Safari: Developer features
  defaults write "${safari_plist}" IncludeDevelopMenuPreferenceKey -bool true
  defaults write "${safari_plist}" WebKitDeveloperExtrasEnabledPreferenceKey -bool true
  defaults write "${safari_plist}" com.apple.Safari.ContentPageGroupIdentifier.WebKit2DeveloperExtrasEnabled -bool true
  defaults write NSGlobalDomain WebKitDeveloperExtras -bool true

  # Safari: behavior
  defaults write "${safari_plist}" ShowFullURLInSmartSearchField -bool true
  defaults write "${safari_plist}" AutoOpenSafeDownloads -bool false
  defaults write "${safari_plist}" WarnAboutFraudulentWebsites -bool true
  defaults write "${safari_plist}" WebKitTabToLinksPreferenceKey -bool true
  defaults write "${safari_plist}" com.apple.Safari.ContentPageGroupIdentifier.WebKit2TabsToLinks -bool true
  defaults write "${safari_plist}" HomePage -string "about:blank"
  defaults write "${safari_plist}" InstallExtensionUpdatesAutomatically -bool true

  # Safari: search privacy
  defaults write "${safari_plist}" UniversalSearchEnabled -bool false
  defaults write "${safari_plist}" SuppressSearchSuggestions -bool true

  killall cfprefsd 2>/dev/null || true
else
  echo "Skipping Safari prefs: grant Full Disk Access to your terminal, quit/reopen it, then rerun." >&2
fi

# Apply changes
killall Dock Finder SystemUIServer 2>/dev/null || true

