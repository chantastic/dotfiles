[init]
	defaultBranch = main
[user]
	name = Michael Chan
	email = mijoch@gmail.com
[ui]
	color = auto
[diff]
	compactionHeuristic = true
	colorMoved = zebra
[alias]
	a = add
	b = branch
	branches = for-each-ref --sort=-committerdate --format='"%(color:blue)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)"' refs/remotes
	c = commit
	d = diff
	e = reset
	f = fetch
	g = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset'
	h = cherry-pick
	i = init
	# j =
	# k =
	l = pull
	m = merge
	n = config
	o = checkout
	p = push
	# q =
	r = rebase
	s = status
	t = tag
	u = prune
	# v =
	w = switch
	# x = 
	# y = 
	# z = 
[push]
	default = current
	followTags = true
	autoSetupRemote = true
[log]
	pretty = oneline
	abbrevCommit = true
	decorate = short
	date = relative
[format]
	pretty = oneline
[fetch]
	prune = true
[rebase]
	autosquash = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[core]
	editor = vim
[help]
	autocorrect = 1
[pull]
	rebase = true

[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[alto "https://git.workos.cloud"]
	binding = 8809af84f60918bc7f7585b0191bcb007b2b5e73a60de84a4585900b4c15c87b
[url "alto::8809af84f60918bc7f7585b0191bcb007b2b5e73a60de84a4585900b4c15c87b::https://git.workos.cloud/"]
	insteadOf = https://git.workos.cloud/
